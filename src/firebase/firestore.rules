  // Follow-up reviews: immutable corrections, candidate clarification and explicitly consented blind review.
  function workExternal(id) {
   let a = workAssignment(id);
   let r = get(/databases/$(database)/documents/aligna_work_review_requests/$(id + '--' + request.auth.uid)).data;
   return verifiedAccount() && r.reviewerUid == request.auth.uid && r.assignmentId == id && r.status == 'approved'
    && r.consentVersion == 'independent-task-share-v1' && workApplication(a.applicationId).active == true;
  }
  function workAllRatings(v) {
   return v is list && v.size() == 4 && workRating(v[0],'numeracy','calculation') && workRating(v[1],'constraints','decision')
