  function workAnswers(v,task) {
   return v is map && v.keys().hasAll(['decision','calculation','reasoning','verification','claimedMaximum','uniqueCount','completedCount','selected','exceptions'])
    && v.keys().hasOnly(['decision','calculation','reasoning','verification','claimedMaximum','uniqueCount','completedCount','selected','exceptions'])
    && v.decision is string && v.decision.size() <= 4000 && v.calculation is string && v.calculation.size() <= 4000
    && v.reasoning is string && v.reasoning.size() <= 4000 && v.verification is string && v.verification.size() <= 4000
    && v.claimedMaximum is string && v.claimedMaximum.size() <= 40 && v.uniqueCount is string && v.uniqueCount.size() <= 40 && v.completedCount is string && v.completedCount.size() <= 40
    && v.selected is list && v.selected.size() <= 6 && v.selected.toSet().size() == v.selected.size() && v.selected.hasOnly(['A','B','C','D','E','F'])
    && v.exceptions is list && v.exceptions.size() <= 12 && v.exceptions.toSet().size() == v.exceptions.size()
    && v.exceptions.hasOnly(['P101','P102','P103','P104','P105','P106','Q201','Q202','Q203','Q204','Q205','Q206'])
