r.workOutputs.size() > 18 && r.workOutputs[18].skillIds.hasAny(d.skillIds) ? r.workOutputs[18].id : '',
r.workOutputs.size() > 19 && r.workOutputs[19].skillIds.hasAny(d.skillIds) ? r.workOutputs[19].id : ''];
   return d.skillIds.toSet() == r.skillIds.toSet().intersection(allowed.toSet())
