r.workOutputs.size() > 9 && r.workOutputs[9].skillIds.hasAny(d.skillIds) ? r.workOutputs[9].id : '',
r.workOutputs.size() > 10 && r.workOutputs[10].skillIds.hasAny(d.skillIds) ? r.workOutputs[10].id : '',
r.workOutputs.size() > 11 && r.workOutputs[11].skillIds.hasAny(d.skillIds) ? r.workOutputs[11].id : '',
r.workOutputs.size() > 12 && r.workOutputs[12].skillIds.hasAny(d.skillIds) ? r.workOutputs[12].id : '',
