  function workRating(r,key,field) {
   return r is map && r.keys().hasOnly(['criterionId','sourceField','score','observation'])
    && r.criterionId == key && r.sourceField == field && r.score in [null,1,2,3]
    && r.observation is string && r.observation.size() <= 1500 && (r.score == null || r.observation.size() > 0);
  }
  match /aligna_work_reviews/{id} {
   allow get: if workSeeker(workAssignment(id)) || workEmployer(workAssignment(id));
