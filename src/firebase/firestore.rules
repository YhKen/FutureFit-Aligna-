  match /aligna_work_corrections/{id} {
   allow get, list: if workShared(resource.data);
   allow create: if validCorrection(request.resource.data);
   function validCorrection(d) {
    let a = workAssignment(d.assignmentId);
    let hpath = /databases/$(database)/documents/aligna_work_review_heads/$(d.assignmentId);
    let prior = exists(hpath) ? get(hpath).data : {'revision':0,'correctionId':''};
    return workEmployer(a) && d.keys().hasOnly(['assignmentId','applicationId','employerUid','seekerUid','reviewerUid','revision','previousId','reason','attemptVersion','rubricVersion','ratings','createdAt'])
