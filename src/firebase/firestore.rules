  }
  match /aligna_work_attempts/{id} {
   function validAttempt(d) {
    let a = workAssignment(id);
    return d.keys().hasOnly(['assignmentId','applicationId','employerUid','seekerUid','taskId','variant','taskVersion','rubricVersion','condition','status','answers','declaredTools','consentVersion','createdAt','startedAt','updatedAt','submittedAt'])
     && d.assignmentId == id && d.applicationId == a.applicationId && d.employerUid == a.employerUid && d.seekerUid == a.seekerUid
     && d.taskId == a.taskId && d.variant == a.variant && d.taskVersion == a.taskVersion && d.rubricVersion == a.rubricVersion && d.condition == a.condition
     && workAnswers(d.answers,a.taskId) && d.declaredTools is list && d.declaredTools.size() <= 3
     && d.declaredTools.toSet().size() == d.declaredTools.size() && d.declaredTools.hasOnly(['calculator','spreadsheet','ai'])
     && (a.condition != 'independent' || !d.declaredTools.hasAny(['ai']))
