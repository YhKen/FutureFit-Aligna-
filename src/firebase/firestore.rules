  match /aligna_work_independent_reviews/{id} {
   function req() { return get(/databases/$(database)/documents/aligna_work_review_requests/$(id)).data; }
   allow get: if workShared(req()) || (verifiedAccount() && req().reviewerUid == request.auth.uid && req().status == 'approved' && workApplication(req().applicationId).active == true);
   allow create: if verifiedAccount() && req().reviewerUid == request.auth.uid && req().status == 'approved' && workApplication(req().applicationId).active == true
    && request.auth.uid != req().employerUid && request.auth.uid != req().seekerUid && validIndependent(request.resource.data);
   function validIndependent(d) {
