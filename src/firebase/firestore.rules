  function workSameAssignment(d,a) {
   return d.assignmentId is string && d.applicationId == a.applicationId && d.employerUid == a.employerUid && d.seekerUid == a.seekerUid;
  }
  function workShared(d) { return workSeeker(d) || workEmployer(d); }
  function workOriginal(id) { return get(/databases/$(database)/documents/aligna_work_reviews/$(id)).data; }
  match /aligna_work_review_heads/{id} {
   allow get: if workShared(workAssignment(id));
   function validHead(d) {
