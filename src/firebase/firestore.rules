    && request.resource.data.jobRequirementsVersion == workApplication(request.resource.data.applicationId).jobRequirementsVersion
    && request.resource.data.skillIds is list && request.resource.data.skillIds.size() > 0 && request.resource.data.skillIds.size() <= 8
    && request.resource.data.skillIds.toSet().size() == request.resource.data.skillIds.size()
    && request.resource.data.workOutputIds is list && request.resource.data.workOutputIds.size() > 0 && request.resource.data.workOutputIds.size() <= 20
    && request.resource.data.workOutputIds.toSet().size() == request.resource.data.workOutputIds.size()
    && workTaskLinks(request.resource.data)
    && request.resource.data.taskId in ['resource-plan','record-audit'] && request.resource.data.variant in ['A','B']
    && id == request.resource.data.applicationId + '--' + request.resource.data.taskId + '--' + request.resource.data.variant
    && request.resource.data.taskVersion == 'formal-work-v1'
    && request.resource.data.rubricVersion == workRubric(request.resource.data.taskId,request.resource.data.variant)
    && request.resource.data.condition in ['independent','ai-assisted'] && request.resource.data.minutes in [15,20,25,30,45,60]
    && request.resource.data.createdAt == request.time;
