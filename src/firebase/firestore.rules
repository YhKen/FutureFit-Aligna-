    && request.resource.data.assignmentId == id && request.resource.data.applicationId == workAssignment(id).applicationId
    && request.resource.data.employerUid == request.auth.uid && request.resource.data.reviewerUid == request.auth.uid
    && request.resource.data.seekerUid == workAssignment(id).seekerUid && request.resource.data.taskVersion == workAssignment(id).taskVersion
    && request.resource.data.rubricVersion == workAssignment(id).rubricVersion
    && request.resource.data.attemptVersion is string && request.resource.data.attemptVersion.size() <= 80
    && request.resource.data.ratings is list && request.resource.data.ratings.size() == 4
