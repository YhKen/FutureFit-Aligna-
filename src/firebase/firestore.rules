rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /aligna_question_banks/{bank} {
   allow get: if request.auth != null && bank in ['mini-ipip-en-v1','onet-mini-ip-en-v1','aligna-multidomain-v2'];
  }
  match /aligna_users/{uid}/sessions/{session} {
   function owner() { return request.auth != null && request.auth.uid == uid; }
   function valid() {
    let d = request.resource.data;
    return d.keys().hasOnly(['schemaVersion','seed','responses','status','createdAt','updatedAt','completedAt','nextReviewAt','locale','bankVersions','consentVersion','algorithmVersion','isTest','totalQuestions','profile'])
      && d.seed is int && d.responses is list && d.status in ['in-progress','complete']
      && d.createdAt is string && d.updatedAt is string && d.locale in ['zh','en','ms'] && d.isTest is bool
      && ((d.schemaVersion == 1 && d.responses.size() <= 30 && d.algorithmVersion == 'coverage-clarification-v1' && d.bankVersions == ['mini-ipip-en-v1','onet-mini-ip-en-v1'] && d.consentVersion == '2026-10-pilot-v1' && (d.status != 'complete' || d.responses.size() == 30))
      || (d.schemaVersion == 2 && d.totalQuestions in [30,40,50,60] && d.responses.size() <= d.totalQuestions && (d.status != 'complete' || d.responses.size() == d.totalQuestions)
      && d.algorithmVersion == 'evidence-routing-v2' && d.bankVersions == ['aligna-multidomain-v2'] && d.consentVersion == '2026-10-profile-v2'
      && d.profile is map && d.profile.keys().hasOnly(['name','education','experience','goal','confirmedSkills'])
      && d.profile.name is string && d.profile.name.size() <= 200 && d.profile.education is string && d.profile.education.size() <= 12000
      && d.profile.experience is string && d.profile.experience.size() <= 20000 && d.profile.goal is string && d.profile.goal.size() <= 3000
      && d.profile.confirmedSkills is list && d.profile.confirmedSkills.size() <= 35));
   }
   allow read: if owner();
   allow create: if owner() && valid();
   allow update: if owner() && valid() && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.seed == resource.data.seed;
  }
  match /aligna_users/{uid}/preferences/{preference} {
   function ownsPreference() { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; }
   allow read: if ownsPreference();
   allow create, update: if ownsPreference() && preference == 'job-search'
    && request.resource.data.keys().hasOnly(['location','minSalary','employmentType','arrangement','companyWish','updatedAt'])
    && request.resource.data.location is string && request.resource.data.location.size() <= 200
    && request.resource.data.minSalary is number && request.resource.data.minSalary >= 0 && request.resource.data.minSalary <= 10000000
    && request.resource.data.employmentType in ['','Full-time','Part-time']
    && request.resource.data.arrangement in ['','remote','hybrid','onsite']
    && request.resource.data.companyWish is string && request.resource.data.companyWish.size() <= 500
    && request.resource.data.updatedAt is string;
  }
  match /aligna_users/{uid}/plans/{plan} {
   function owner() { return request.auth != null && request.auth.uid == uid; }
   allow read: if owner();
   allow create, update: if owner() && request.resource.data.keys().hasOnly(['skillId','steps','version','updatedAt'])
    && request.resource.data.skillId == plan && plan.matches('skill-.*')
    && request.resource.data.version == 1 && request.resource.data.updatedAt is string
    && request.resource.data.steps is list && request.resource.data.steps.size() == 3
    && request.resource.data.steps[0] is bool && request.resource.data.steps[1] is bool && request.resource.data.steps[2] is bool;
  }
  match /aligna_users/{uid}/games/{run} {
   allow read: if request.auth != null && request.auth.uid == uid;
   allow create: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['type','trials','summary','updatedAt','consentVersion','version'])
    && request.resource.data.type in ['memory','switch'] && request.resource.data.version == 1
    && request.resource.data.trials is list && request.resource.data.trials.size() <= 60
    && request.resource.data.summary is map && request.resource.data.updatedAt is string
    && request.resource.data.consentVersion == 'games-v1';
  }

  // Private seeker records never grant employers or the news worker access.
  function privateSeeker(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; }
  function seekerSettings(s) {
   return s is map && s.keys().hasOnly(['goalId','country','months','hours','budget','learningLanguage'])
    && s.goalId is string && (s.goalId == '' || s.goalId.matches('[0-9]{2}-[0-9]{4}[.][0-9]{2}'))
    && s.country in ['MY','SG','UK','AU','US'] && s.months in [3,5,6,12]
    && s.hours is int && s.hours >= 1 && s.hours <= 40
    && s.budget is number && s.budget >= 0 && s.budget <= 1000000
    && s.learningLanguage in ['zh','en','ms'];
  }

  // Life experience and career try-outs stay private, including after an application.
  function lifeClaim(c) {
   return c is map && c.keys().hasOnly(['skillId','name','evidenceQuote','start','end','confidence','sourceType','verified'])
    && c.skillId is string && c.skillId.size() <= 180 && c.name is string && c.name.size() <= 100
    && c.evidenceQuote is string && c.evidenceQuote.size() > 0 && c.evidenceQuote.size() <= 4000
    && c.start is int && c.end is int && c.start >= 0 && c.end > c.start && c.end <= 4000
    && c.confidence == 'explicit-action' && c.sourceType == 'life-experience-self-report' && c.verified == false;
  }
  function lifeClaimAt(list, i) { return list.size() <= i || lifeClaim(list[i]); }
  function lifeRef(c) {
   return c.keys().hasOnly(['skillId','start','end']) && c.skillId is string && c.skillId.size() <= 180
    && c.start is int && c.end is int && c.start >= 0 && c.end > c.start && c.end <= 4000;
  }
  function lifeRefAt(list,i) { return list.size() <= i || lifeRef(list[i]); }
  match /aligna_users/{uid}/life_experiences/{id} {
   function validLife(d) {
    let claims=d.claims;
    return d.keys().hasOnly(['version','experienceId','text','type','locale','claims','active','sourceType','verified','createdAt','updatedAt'])
     && d.version in ['life-evidence-v1','life-evidence-v2'] && d.experienceId == id && id.size() <= 80
     && d.text is string && d.text.size() >= 8 && d.text.size() <= 4000
     && d.type in ['care','market','club','sport','part-time','community','other'] && d.locale in ['zh','en','ms']
     && d.claims is list && d.claims.size() > 0 && d.claims.size() <= 12
     && ((d.version == 'life-evidence-v1'
     && lifeClaimAt(claims,0) && lifeClaimAt(claims,1) && lifeClaimAt(claims,2) && lifeClaimAt(claims,3)
     && lifeClaimAt(claims,4) && lifeClaimAt(claims,5) && lifeClaimAt(claims,6) && lifeClaimAt(claims,7)
     && lifeClaimAt(claims,8) && lifeClaimAt(claims,9) && lifeClaimAt(claims,10) && lifeClaimAt(claims,11))
     || (d.version == 'life-evidence-v2'
     && lifeRefAt(claims,0) && lifeRefAt(claims,1) && lifeRefAt(claims,2) && lifeRefAt(claims,3)
     && lifeRefAt(claims,4) && lifeRefAt(claims,5) && lifeRefAt(claims,6) && lifeRefAt(claims,7)
     && lifeRefAt(claims,8) && lifeRefAt(claims,9) && lifeRefAt(claims,10) && lifeRefAt(claims,11)))
     && d.active is bool && d.sourceType == 'life-experience-self-report' && d.verified == false
     && d.createdAt is string && d.updatedAt is string;
   }
   allow read: if privateSeeker(uid);
   allow create: if privateSeeker(uid) && validLife(request.resource.data) && request.resource.data.active == true
    && request.resource.data.updatedAt == request.resource.data.createdAt;
   allow update: if privateSeeker(uid) && validLife(request.resource.data) && request.resource.data.active == false
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedAt']);
  }
  function tryCheckAt(list,i) { return list.size() <= i || (list[i] is map && list[i].keys().hasOnly(['key','status'])
   && list[i].key in ['selection','time','budget','target','feasibility','maximum','sum','mismatch','facts','approval','privacy','written-reasoning']
   && list[i].status in ['pass','conflict','unobserved']); }
  match /aligna_users/{uid}/career_trials/{id} {
   function validTrial(d) {
    let a=d.answers;let r=d.reflection;let v=d.result;
    return d.keys().hasOnly(['version','definitionHash','attemptId','goalId','templateId','locale','sourceType','verified','answers','result','reflection','startedAt','createdAt','updatedAt'])
     && d.version == 'career-try-v1' && d.attemptId == id && id.size() <= 80
     && d.definitionHash is string && d.definitionHash.matches('try-definition:[a-f0-9]{16}')
     && d.goalId is string && d.goalId.matches('[0-9]{2}-[0-9]{4}[.][0-9]{2}')
     && d.templateId in ['budget','records','customer'] && d.locale in ['zh','en','ms']
     && d.sourceType == 'career-simulation-self-report' && d.verified == false
     && a is map && a.keys().hasOnly(['selected','followUp','infeasible','maximum','sum','mismatch','policy','explanation','verification'])
     && a.selected is list && a.selected.size() <= 4 && a.selected.hasOnly(['A','B','C','D'])
     && a.followUp is bool && a.infeasible is bool && a.mismatch is bool
     && a.maximum is string && a.maximum.size() <= 30 && a.sum is string && a.sum.size() <= 30
     && a.policy in ['','check-order','promise-refund','request-password']
     && a.explanation is string && a.explanation.size() >= 10 && a.explanation.size() <= 4000
     && a.verification is string && a.verification.size() <= 4000
     && r is map && r.keys().hasOnly(['ease','interest','liked','hard']) && r.ease is int && r.ease >= 1 && r.ease <= 5
     && r.interest is int && r.interest >= 1 && r.interest <= 5
     && r.liked is string && r.liked.size() <= 4000 && r.hard is string && r.hard.size() <= 4000
     && v is map && v.keys().hasOnly(['version','checks','verified','scope']) && v.version == 'career-try-v1'
     && v.verified == false && v.scope == 'this-simplified-scenario-only'
     && v.checks is list && v.checks.size() > 0 && v.checks.size() <= 8
     && tryCheckAt(v.checks,0) && tryCheckAt(v.checks,1) && tryCheckAt(v.checks,2) && tryCheckAt(v.checks,3)
     && tryCheckAt(v.checks,4) && tryCheckAt(v.checks,5) && tryCheckAt(v.checks,6) && tryCheckAt(v.checks,7)
     && d.startedAt is string && d.startedAt.size() <= 40 && d.createdAt is string && d.updatedAt == d.createdAt;
   }
   allow read: if privateSeeker(uid);
   allow create: if privateSeeker(uid) && validTrial(request.resource.data);
  }


  // Seeker career tools: private planning and reflection, never employer evidence.
  match /aligna_users/{uid}/seeker_availability/{id} {
   allow read: if privateSeeker(uid);
   allow create, update: if privateSeeker(uid) && id == 'current'
    && request.resource.data.keys().hasOnly(['version','blocked','timeZone','studyHours','workHours','startDate','weeks','goalId','updatedAt'])
    && request.resource.data.version == 'seeker-tools-v1' && request.resource.data.blocked is string && request.resource.data.blocked.matches('[01]{168}')
    && request.resource.data.timeZone == 'Asia/Kuala_Lumpur' && request.resource.data.studyHours is int && request.resource.data.studyHours >= 1 && request.resource.data.studyHours <= 40
    && request.resource.data.workHours is int && request.resource.data.workHours >= 1 && request.resource.data.workHours <= 80
    && request.resource.data.weeks is int && request.resource.data.weeks >= 1 && request.resource.data.weeks <= 52
    && request.resource.data.startDate is string && request.resource.data.startDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
    && request.resource.data.goalId is string && (request.resource.data.goalId == '' || request.resource.data.goalId.matches('[0-9]{2}-[0-9]{4}[.][0-9]{2}'))
    && request.resource.data.updatedAt is string;
  }
  match /aligna_users/{uid}/career_reflections/{id} {
   function validReflection(d) {return d.keys().hasOnly(['version','reflectionId','applicationId','applicationDigest','event','letter','locale','active','createdAt','updatedAt'])
    && d.version == 'seeker-tools-v1' && d.reflectionId == id && id.size() <= 80
    && d.applicationId is string && d.applicationId.size() > 0 && d.applicationId.size() <= 200
    && d.applicationDigest is string && d.applicationDigest.matches('reflection-source:[a-f0-9]{16}')
    && d.event in ['rejected','no-reply'] && d.letter is string && d.letter.size() <= 6000 && (d.event != 'no-reply' || d.letter == '')
    && d.locale in ['zh','en','ms'] && d.active is bool && d.createdAt is string && d.updatedAt is string;}
   allow read: if privateSeeker(uid);
   allow create: if privateSeeker(uid) && validReflection(request.resource.data) && request.resource.data.active == true && request.resource.data.createdAt == request.resource.data.updatedAt
    && get(/databases/$(database)/documents/aligna_applications/$(request.resource.data.applicationId)).data.seekerUid == uid;
   allow update: if privateSeeker(uid) && validReflection(request.resource.data) && request.resource.data.active == false
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedAt']);
  }
  function prioritySkillAt(list,i) {return list.size() <= i || (list[i] is string && list[i].size() > 0 && list[i].size() <= 100);}
  match /aligna_users/{uid}/career_priorities/{id} {
   allow read: if privateSeeker(uid);
   allow create, update: if privateSeeker(uid) && id == 'rejection'
    && request.resource.data.keys().hasOnly(['version','skills','sourceDigest','sourceType','updatedAt'])
    && request.resource.data.version == 'seeker-tools-v1' && request.resource.data.sourceType == 'reflection-user-confirmed'
    && request.resource.data.skills is list && request.resource.data.skills.size() > 0 && request.resource.data.skills.size() <= 6
    && prioritySkillAt(request.resource.data.skills,0) && prioritySkillAt(request.resource.data.skills,1) && prioritySkillAt(request.resource.data.skills,2) && prioritySkillAt(request.resource.data.skills,3) && prioritySkillAt(request.resource.data.skills,4) && prioritySkillAt(request.resource.data.skills,5)
    && request.resource.data.sourceDigest is string && request.resource.data.sourceDigest.matches('reflection-priority:[a-f0-9]{16}')
    && request.resource.data.updatedAt is string;
  }
  match /aligna_users/{uid}/career_options/{id} {
   function validOption(d) {return d.keys().hasOnly(['version','optionId','title','slots','ratePeriod','rateMinCents','rateMaxCents','skills','sourceType','sourceJobId','sourceUrl','checkedAt','arrangement','createdAt','updatedAt','active'])
    && d.version == 'seeker-tools-v1' && d.optionId == id && id.size() <= 80 && d.title is string && d.title.size() > 0 && d.title.size() <= 150
    && d.slots is string && d.slots.matches('[01]{168}') && d.slots.matches('.*1.*')
    && d.ratePeriod in ['hour','month'] && d.rateMinCents is int && d.rateMaxCents is int && d.rateMinCents >= 0 && d.rateMaxCents >= d.rateMinCents && d.rateMaxCents <= 100000000
    && d.skills is string && d.skills.size() <= 1500 && d.sourceType == 'user-entered' && d.sourceJobId == ''
    && d.sourceUrl is string && d.sourceUrl.size() <= 500 && d.sourceUrl.matches('https://.+')
    && d.checkedAt is string && d.checkedAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.arrangement in ['onsite','remote']
    && d.createdAt is string && d.updatedAt is string && d.active is bool;}
   allow read: if privateSeeker(uid);
   allow create: if privateSeeker(uid) && validOption(request.resource.data) && request.resource.data.active == true && request.resource.data.createdAt == request.resource.data.updatedAt;
   allow update: if privateSeeker(uid) && validOption(request.resource.data) && request.resource.data.active == false
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedAt']);
  }

  match /aligna_users/{uid}/seeker_state/{id} {
   allow read: if privateSeeker(uid);
   allow create, update: if privateSeeker(uid) && id == 'settings'
    && request.resource.data.keys().hasOnly(['version','goalId','country','months','hours','budget','learningLanguage','updatedAt'])
    && request.resource.data.version == 'seeker-private-v1' && request.resource.data.updatedAt is string
    && seekerSettings({'goalId':request.resource.data.goalId,'country':request.resource.data.country,'months':request.resource.data.months,'hours':request.resource.data.hours,'budget':request.resource.data.budget,'learningLanguage':request.resource.data.learningLanguage});
  }
  match /aligna_users/{uid}/practice_attempts/{id} {
   function validPractice(d) {
    return d.keys().hasOnly(['version','attemptId','taskId','formVersion','sourceType','verified','condition','locale','goalId','answers','result','createdAt','updatedAt'])
     && d.version == 'seeker-private-v1' && d.attemptId == id && id.size() <= 80
     && d.taskId in ['task-budget-tradeoff','task-delivery-handover'] && d.formVersion == 'H03-public-v1'
     && d.sourceType == 'public-self-practice' && d.verified == false && d.condition in ['independent','ai-assisted']
     && d.locale in ['zh','en','ms'] && d.goalId is string && d.goalId.size() <= 20
     && d.createdAt is string && d.updatedAt == d.createdAt
     && d.answers is map && d.answers.keys().hasOnly(['selected','followUp','infeasible','maximum','sum','mismatch','explanation','verification'])
     && d.answers.selected is list && d.answers.selected.size() <= 4 && d.answers.selected.hasOnly(['A','B','C','D'])
     && d.answers.followUp is bool && d.answers.infeasible is bool && d.answers.mismatch is bool
     && d.answers.maximum is string && d.answers.maximum.size() <= 30 && d.answers.sum is string && d.answers.sum.size() <= 30
     && d.answers.explanation is string && d.answers.explanation.size() <= 4000
     && d.answers.verification is string && d.answers.verification.size() <= 4000
     && d.result is map && d.result.size() <= 15 && d.result.numericPassed is bool
     && d.result.reviewRequired == true && d.result.recommendedAdjustment == null && d.result.verification == 'public-practice-unverified';
   }
   allow read: if privateSeeker(uid);
   allow create: if privateSeeker(uid) && validPractice(request.resource.data);
  }
  match /aligna_users/{uid}/learning_actions/{id} {
   function validAction(d) {
    let source = get(/databases/$(database)/documents/aligna_users/$(uid)/practice_attempts/$(id)).data;
    return d.keys().hasOnly(['version','sourceAttemptId','taskId','goalId','skillName','topic','state','sourceType','createdAt','updatedAt'])
     && d.version == 'seeker-private-v1' && d.sourceAttemptId == id && d.taskId == source.taskId && d.goalId == source.goalId
     && d.skillName in ['Management of Financial Resources','Critical Thinking']
     && d.topic in ['check-constraints','explain-tradeoffs','reconcile-totals','verify-records']
     && d.state in ['pending','done'] && d.sourceType == 'self-practice-reflection'
     && d.createdAt is string && d.updatedAt is string;
   }
   allow read: if privateSeeker(uid);
   allow create: if privateSeeker(uid) && validAction(request.resource.data);
   allow update: if privateSeeker(uid) && validAction(request.resource.data)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','updatedAt']);
  }
  match /aligna_users/{uid}/interview_attempts/{id} {
   allow read: if privateSeeker(uid);
   allow create: if privateSeeker(uid)
    && request.resource.data.keys().hasOnly(['version','attemptId','formVersion','sourceType','verified','goalId','locale','answers','checks','createdAt','updatedAt'])
    && request.resource.data.version == 'seeker-private-v1' && request.resource.data.attemptId == id && id.size() <= 80
    && request.resource.data.formVersion in ['public-interview-v1-0','public-interview-v1-1']
    && request.resource.data.sourceType == 'interview-self-practice' && request.resource.data.verified == false
    && request.resource.data.goalId is string && request.resource.data.goalId.size() <= 20 && request.resource.data.locale in ['zh','en','ms']
    && request.resource.data.answers is list && request.resource.data.answers.size() == 3
    && request.resource.data.answers[0] is string && request.resource.data.answers[0].size() <= 4000
    && request.resource.data.answers[1] is string && request.resource.data.answers[1].size() <= 4000
    && request.resource.data.answers[2] is string && request.resource.data.answers[2].size() <= 4000
    && request.resource.data.checks is list && request.resource.data.checks.size() == 3
    && request.resource.data.checks[0] is bool && request.resource.data.checks[1] is bool && request.resource.data.checks[2] is bool
    && request.resource.data.createdAt is string && request.resource.data.updatedAt == request.resource.data.createdAt;
  }
  match /aligna_users/{uid}/learning_routes/{id} {
   allow read: if privateSeeker(uid);
   allow create, update: if privateSeeker(uid) && id.matches('route:[a-f0-9]{16}')
    && request.resource.data.keys().hasOnly(['version','settings','completed','unitVersion','updatedAt'])
    && request.resource.data.version == 'seeker-private-v1' && seekerSettings(request.resource.data.settings)
    && request.resource.data.completed is list && request.resource.data.completed.size() <= 30
    && request.resource.data.unitVersion == 'work-sample-route-v1' && request.resource.data.updatedAt is string;
  }
  match /aligna_users/{uid}/news_receipts/{id} {
   allow read: if privateSeeker(uid);
   allow create, update: if privateSeeker(uid) && id.matches('news:[a-f0-9]{16}')
    && request.resource.data.keys().hasOnly(['version','key','goalId','newsVersion','status','before','after','createdAt','updatedAt','snoozeUntil'])
    && request.resource.data.version == 'seeker-private-v1' && request.resource.data.key == id
    && request.resource.data.goalId is string && request.resource.data.goalId.size() <= 20
    && request.resource.data.newsVersion is string && request.resource.data.newsVersion.size() <= 200
    && request.resource.data.status in ['viewed','later','applied','dismissed','undone']
    && request.resource.data.before is list && request.resource.data.before.size() <= 6
    && request.resource.data.after is list && request.resource.data.after.size() <= 6
    && request.resource.data.createdAt is string && request.resource.data.updatedAt is string && request.resource.data.snoozeUntil is string
    && (!exists(/databases/$(database)/documents/aligna_users/$(uid)/news_receipts/$(id))
     || (request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','snoozeUntil'])));
  }

  function verifiedAccount() { return request.auth != null && request.auth.token.email_verified == true; }
  match /aligna_applications/{application} {
   function snapshotValid(d) {
    let j = get(/databases/$(database)/documents/aligna_jobs/$(d.jobId)).data;
    let r = j.get('requirements', {'skills': [], 'skillIds': []});
    let structured = r.skills.size() > 0;
    return d.jobRequirementsVersion == j.get('requirementsVersion',0)
     && d.matchingBasis == {'schema': structured ? 'structured-v1' : 'legacy-v1', 'skillIds': structured ? r.skillIds : [], 'legacySkills': structured ? '' : j.skills}
     && d.jobSnapshot == {'jobTitle':j.jobTitle,'salary':j.salary,'jobDescription':j.jobDescription,'jobField':j.jobField,'location':j.location,'skills':j.skills,'softSkills':j.softSkills,'jobRequirements':j.jobRequirements,'futureSkills':j.futureSkills,'employmentType':j.employmentType,'employeeCount':j.employeeCount,'workingTime':j.workingTime,'jobSchemaVersion':j.get('jobSchemaVersion',1),'requirementsVersion':j.get('requirementsVersion',0),'requirements':j.get('requirements',null)};
   }
   function candidateValid(d) {
    let c = d.candidate;
    return c is map && c.keys().hasOnly(['displayName','summary','education','experience','location','employmentType','portfolio','skills','synthetic'])
     && c.displayName is string && c.displayName.size() > 0 && c.displayName.size() <= 120
     && c.summary is string && c.summary.size() <= 2000 && c.education is string && c.education.size() <= 1500
     && c.experience is string && c.experience.size() <= 3000 && c.location is string && c.location.size() <= 150
     && c.employmentType in ['','Full-time','Part-time'] && c.portfolio is string && c.portfolio.size() <= 500
     && c.skills is list && c.skills.size() > 0 && c.skills.size() <= 50 && c.synthetic == true;
   }
   function employer() { return verifiedAccount() && resource.data.employerUid == request.auth.uid && resource.data.active == true; }
   function seeker() { return verifiedAccount() && resource.data.seekerUid == request.auth.uid; }
   allow read: if seeker() || employer();
