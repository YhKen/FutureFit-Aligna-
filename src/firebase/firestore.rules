    return d.keys().hasOnly(['requestId','assignmentId','applicationId','employerUid','seekerUid','reviewerUid','attemptVersion','rubricVersion','ratings','blindReview','raterDeclaration','createdAt'])
     && d.requestId == id && d.assignmentId == r.assignmentId && d.applicationId == r.applicationId && d.employerUid == r.employerUid && d.seekerUid == r.seekerUid
     && d.reviewerUid == request.auth.uid && d.attemptVersion == r.attemptVersion && d.rubricVersion == r.rubricVersion
     && d.blindReview == true && workAllRatings(d.ratings) && (!d.keys().hasAny(['raterDeclaration']) || vRaterDeclaration(d.raterDeclaration)) && d.createdAt == request.time;
   }
  }

  // Validation studies: private coordination; public task packets for named experts.
  // Existing candidate-controlled work review remains the ONLY raw-answer sharing path.
  function vStudy(id) { return get(/databases/$(database)/documents/aligna_validation_studies/$(id)).data; }
  function vOwner(s) { return verifiedAccount() && s.ownerUid == request.auth.uid; }
  function vText(v,n) { return v is string && v.size() > 0 && v.size() <= n; }
  function vOpinionRating(r,id) {
   return r is map && r.keys().hasOnly(['criterionId','relevance','clarity','observability','fairness','comment']) && r.criterionId == id
    && r.relevance is int && r.relevance >= 1 && r.relevance <= 4 && r.clarity is int && r.clarity >= 1 && r.clarity <= 4
    && r.observability is int && r.observability >= 1 && r.observability <= 4 && r.fairness is int && r.fairness >= 1 && r.fairness <= 4
    && vText(r.comment,1500) && r.comment.size() >= 5;
  }
  function vRaterDeclaration(d) {
   return d is map && d.keys().hasOnly(['version','ownWork','noDiscussion','aiUsed','identityRecognized','conflicts','synthetic'])
    && d.version == 'rater-declaration-v1' && d.ownWork is bool && d.noDiscussion is bool && d.aiUsed is bool
    && d.identityRecognized is bool && d.conflicts is string && d.conflicts.size() <= 1000 && d.synthetic is bool;
  }
  match /aligna_validation_studies/{id} {
   allow get, list: if vOwner(resource.data);
   allow create: if verifiedAccount() && validStudy(request.resource.data);
   function validStudy(d) {
    let a=workAssignment(d.referenceAssignmentId); let app=workApplication(a.applicationId);
    return workEmployer(a) && d.keys().hasOnly(['ownerUid','title','referenceAssignmentId','jobId','jobRequirementsVersion','publicJob','taskId','variant','taskVersion','rubricVersion','condition','minutes','language','raterA','raterB','expertUids','protocol','phase','caseIds','reportIds','validationStatus','frozenAt','closedAt','createdAt','updatedAt'])
     && d.ownerUid == request.auth.uid && vText(d.title,160) && d.jobId == a.jobId && d.jobRequirementsVersion == app.jobRequirementsVersion && d.publicJob == app.jobSnapshot
     && d.taskId == a.taskId && d.variant == a.variant && d.taskVersion == a.taskVersion && d.rubricVersion == a.rubricVersion && d.condition == a.condition && d.minutes == a.minutes
     && d.language in ['zh','en','ms'] && d.raterA is string && d.raterA.matches('[a-zA-Z0-9_-]{1,128}') && d.raterB is string && d.raterB.matches('[a-zA-Z0-9_-]{1,128}')
     && d.raterA != d.raterB && d.raterA != request.auth.uid && d.raterB != request.auth.uid
     && d.expertUids is list && d.expertUids.size() > 0 && d.expertUids.size() <= 10 && d.expertUids.toSet().size() == d.expertUids.size() && !d.expertUids.hasAny([request.auth.uid])
     && d.protocol is map && d.protocol.keys().hasOnly(['targetCases','targetExperts','acceptanceRule','samplingPlan'])
     && d.protocol.targetCases is int && d.protocol.targetCases >= 10 && d.protocol.targetCases <= 60 && d.protocol.targetExperts is int && d.protocol.targetExperts >= 2 && d.protocol.targetExperts <= 10
     && vText(d.protocol.acceptanceRule,3000) && d.protocol.acceptanceRule.size() >= 20 && vText(d.protocol.samplingPlan,3000)
     && d.phase == 'draft' && d.caseIds == [] && d.reportIds == [] && d.validationStatus == 'pending-human-validation' && d.frozenAt == null && d.closedAt == null && d.createdAt == request.time && d.updatedAt == request.time;
   }
   function manifestChange(d,old) {
    let nc=d.caseIds.size(); let nr=d.reportIds.size();
    return (d.caseIds == old.caseIds && d.reportIds == old.reportIds)
     || (old.phase == 'collecting' && nc == old.caseIds.size()+1 && nc <= 60 && d.caseIds == old.caseIds.concat([d.caseIds[nc-1]]) && d.reportIds == old.reportIds
      && getAfter(/databases/$(database)/documents/aligna_validation_cases/$(d.caseIds[nc-1])).data.studyId == id)
     || (nr == old.reportIds.size()+1 && nr <= 20 && d.reportIds == old.reportIds.concat([d.reportIds[nr-1]]) && d.caseIds == old.caseIds
      && getAfter(/databases/$(database)/documents/aligna_validation_reports/$(d.reportIds[nr-1])).data.studyId == id);
   }
   allow update: if vOwner(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','caseIds','reportIds','updatedAt','frozenAt','closedAt'])
    && request.resource.data.updatedAt == request.time
    && ((resource.data.phase == 'draft' && request.resource.data.phase == 'collecting' && request.resource.data.frozenAt == request.time && request.resource.data.closedAt == null && request.resource.data.caseIds == [] && request.resource.data.reportIds == [])
     || (resource.data.phase == 'collecting' && request.resource.data.phase == 'closed' && request.resource.data.frozenAt == resource.data.frozenAt && request.resource.data.closedAt == request.time && request.resource.data.caseIds == resource.data.caseIds && request.resource.data.reportIds == resource.data.reportIds)
     || (resource.data.phase in ['collecting','closed'] && request.resource.data.phase == resource.data.phase && request.resource.data.frozenAt == resource.data.frozenAt && request.resource.data.closedAt == resource.data.closedAt && manifestChange(request.resource.data,resource.data)));
  }
  match /aligna_validation_experts/{id} {
   allow get, list: if vOwner(resource.data) || (verifiedAccount() && resource.data.expertUid == request.auth.uid && resource.data.state != 'revoked');
   allow create: if validPacket(request.resource.data);
   function validPacket(d) {
    let s=getAfter(/databases/$(database)/documents/aligna_validation_studies/$(d.studyId)).data;
    return vOwner(s) && s.phase == 'collecting' && s.expertUids.hasAny([d.expertUid]) && id == d.studyId+'--'+d.expertUid
     && d.keys().hasOnly(['studyId','ownerUid','expertUid','publicJob','taskId','variant','taskVersion','rubricVersion','language','state','createdAt','updatedAt'])
     && d.ownerUid == s.ownerUid && d.publicJob == s.publicJob && d.taskId == s.taskId && d.variant == s.variant && d.taskVersion == s.taskVersion && d.rubricVersion == s.rubricVersion && d.language == s.language
     && d.state == 'open' && d.createdAt == request.time && d.updatedAt == request.time;
   }
   allow update: if vOwner(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','updatedAt']) && request.resource.data.updatedAt == request.time
    && ((resource.data.state in ['open','closed'] && request.resource.data.state == 'revoked')
     || (resource.data.state == 'open' && request.resource.data.state == 'closed' && getAfter(/databases/$(database)/documents/aligna_validation_studies/$(resource.data.studyId)).data.phase == 'closed'));
  }
  match /aligna_validation_opinions/{id} {
   function packet(){return get(/databases/$(database)/documents/aligna_validation_experts/$(id)).data;}
   allow get: if vOwner(packet()) || (verifiedAccount() && packet().expertUid == request.auth.uid && packet().state != 'revoked');
   allow list: if vOwner(resource.data);
   allow create: if verifiedAccount() && packet().expertUid == request.auth.uid && packet().state == 'open' && vStudy(packet().studyId).phase == 'collecting' && validOpinion(request.resource.data);
   function validOpinion(d) {
    let p=packet();
    return d.keys().hasOnly(['studyId','ownerUid','expertUid','packetVersion','rubricVersion','background','conflicts','coverageNotes','recommendation','synthetic','independent','criteria','consentVersion','createdAt'])
     && d.studyId == p.studyId && d.ownerUid == p.ownerUid && d.expertUid == request.auth.uid && d.rubricVersion == p.rubricVersion && vText(d.packetVersion,100)
     && vText(d.background,1500) && d.background.size() >= 10 && vText(d.conflicts,1000) && vText(d.coverageNotes,2000) && d.coverageNotes.size() >= 10
     && d.recommendation in ['revise','pilot-review','not-suitable'] && d.synthetic is bool && d.independent is bool && (d.synthetic || d.independent)
     && d.criteria is list && d.criteria.size() == 4 && vOpinionRating(d.criteria[0],'numeracy') && vOpinionRating(d.criteria[1],'constraints') && vOpinionRating(d.criteria[2],'reasoning') && vOpinionRating(d.criteria[3],'verification')
     && d.consentVersion == 'expert-opinion-share-v1' && d.createdAt == request.time;
   }
  }
  match /aligna_validation_credentials/{id} {
   allow get, list: if vOwner(resource.data);
   allow create: if validCredential(request.resource.data);
   function validCredential(d){let s=vStudy(d.studyId);return vOwner(s) && id == d.studyId+'--'+d.reviewerUid && s.expertUids.concat([s.raterA,s.raterB]).hasAny([d.reviewerUid])
    && d.keys().hasOnly(['studyId','ownerUid','reviewerUid','reviewerName','professionalRole','verificationNote','humanChecked','synthetic','scope','createdAt'])
    && d.ownerUid == request.auth.uid && vText(d.reviewerName,120) && vText(d.professionalRole,300) && vText(d.verificationNote,2000) && d.verificationNote.size() >= 20
    && d.humanChecked == true && d.synthetic is bool && d.scope == 'Qualification check declared by study owner, not independently verified by the software' && d.createdAt == request.time;}
  }
  match /aligna_validation_cases/{id} {
   allow get: if vOwner(resource.data) || (verifiedAccount() && resource.data.seekerUid == request.auth.uid);
   allow list: if vOwner(resource.data);
   allow create: if validCase(request.resource.data);
   function validCase(d){let s=vStudy(d.studyId);let a=workAssignment(d.assignmentId);let app=workApplication(a.applicationId);
    return vOwner(s) && s.phase == 'collecting' && workEmployer(a) && d.keys().hasOnly(['studyId','ownerUid','studyTitle','caseAlias','assignmentId','applicationId','seekerUid','attemptVersion','profileSynthetic','redactionChecked','languageChecked','taskId','variant','condition','minutes','reviewerUids','createdAt'])
     && d.ownerUid == request.auth.uid && d.studyTitle == s.title && id == d.studyId+'--'+d.caseAlias && d.caseAlias.matches('C[0-9]{3}')
     && d.applicationId == a.applicationId && d.seekerUid == a.seekerUid && d.seekerUid != s.raterA && d.seekerUid != s.raterB
     && a.jobId == s.jobId && app.jobRequirementsVersion == s.jobRequirementsVersion && a.taskId == s.taskId && a.variant == s.variant && a.rubricVersion == s.rubricVersion && a.condition == s.condition && a.minutes == s.minutes
     && d.taskId == s.taskId && d.variant == s.variant && d.condition == s.condition && d.minutes == s.minutes && d.reviewerUids == [s.raterA,s.raterB]
     && d.get('languageChecked',false) is bool && d.profileSynthetic is bool && d.redactionChecked == true && vText(d.attemptVersion,100)
     && get(/databases/$(database)/documents/aligna_work_attempts/$(d.assignmentId)).data.status == 'submitted'
     && getAfter(/databases/$(database)/documents/aligna_validation_studies/$(d.studyId)).data.caseIds.hasAny([id]) && d.createdAt == request.time;
   }
  }
  match /aligna_validation_participation/{id} {
   function source(){return get(/databases/$(database)/documents/aligna_validation_cases/$(id)).data;}
   allow get: if vOwner(source()) || (verifiedAccount() && source().seekerUid == request.auth.uid);
   allow list: if vOwner(resource.data);
   allow create: if verifiedAccount() && source().seekerUid == request.auth.uid && validParticipation(request.resource.data);
   function validParticipation(d){let c=source();return d.keys().hasOnly(['studyId','caseId','ownerUid','seekerUid','attemptVersion','active','ownHumanResponse','syntheticTest','consentVersion','revokedAt','createdAt','updatedAt'])
    && d.studyId == c.studyId && d.caseId == id && d.ownerUid == c.ownerUid && d.seekerUid == request.auth.uid && d.attemptVersion == c.attemptVersion
    && workApplication(c.applicationId).active == true && vStudy(c.studyId).phase == 'collecting'
    && d.active == true && d.ownHumanResponse is bool && d.syntheticTest is bool && d.consentVersion == 'validation-research-share-v1' && d.revokedAt == null && d.createdAt == request.time && d.updatedAt == request.time;}
   allow update: if verifiedAccount() && resource.data.seekerUid == request.auth.uid && resource.data.active == true && request.resource.data.active == false
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedAt','revokedAt']) && request.resource.data.updatedAt == request.time && request.resource.data.revokedAt == request.time;
  }
  match /aligna_validation_reports/{id} {
   allow get, list: if vOwner(resource.data);
   allow create: if validReport(request.resource.data);
   function validReport(d){let s=vStudy(d.studyId);return vOwner(s) && s.phase in ['collecting','closed'] && d.ownerUid == request.auth.uid
    && d.keys().hasOnly(['studyId','ownerUid','statisticsVersion','sourceDigest','human','demonstration','missingHumanCases','missingHumanExperts','validationStatus','excludedCases','protocol','createdAt'])
    && d.statisticsVersion == 'validation-statistics-v1' && vText(d.sourceDigest,100) && d.human is map && d.demonstration is map
    && d.human.reliability.validationStatus == 'pending-human-validation' && d.human.content.validationStatus == 'pending-human-validation'
    && d.validationStatus == 'pending-human-validation' && d.protocol == s.protocol && d.excludedCases is list && d.excludedCases.size() <= 60
    && d.missingHumanCases is int && d.missingHumanCases >= 0 && d.missingHumanExperts is int && d.missingHumanExperts >= 0
    && getAfter(/databases/$(database)/documents/aligna_validation_studies/$(d.studyId)).data.reportIds.hasAny([id]) && d.createdAt == request.time;}
  }
  match /aligna_validation_decisions/{id} {
   allow get, list: if vOwner(resource.data);
   allow create: if validDecision(request.resource.data);
   function validDecision(d){let s=vStudy(d.studyId);let r=get(/databases/$(database)/documents/aligna_validation_reports/$(d.reportId)).data;return vOwner(s) && s.reportIds.hasAny([d.reportId]) && r.studyId == d.studyId
    && d.keys().hasOnly(['studyId','ownerUid','reportId','sourceDigest','decision','rationale','reviewerName','synthetic','validationStatus','scope','createdAt'])
    && d.ownerUid == request.auth.uid && d.sourceDigest == r.sourceDigest && d.decision in ['revise','pilot-only','need-more-evidence'] && vText(d.rationale,3000) && d.rationale.size() >= 20 && vText(d.reviewerName,120)
    && d.synthetic is bool && d.validationStatus == 'pending-human-validation' && d.scope == 'Internal review record, not a validity certificate or hiring decision' && d.createdAt == request.time;}
  }

  // Isolated news worker: no permission to read raw profiles, answers, games or HR notes.
  function newsWorker() { return request.auth != null && request.auth.uid == 'I03hRbRU9khcQMws8YbdAyjTwSv1'; }
  // Paired synthetic research: no raw CV, questionnaire or game access is granted.
  function pApp(id) {return workApplication(id);}
  function pAccess(id) {let a=pApp(id);return verifiedAccount() && a.active == true && a.synthetic == true && request.auth.uid in [a.employerUid,a.seekerUid];}
  function pOwner(id) {return pAccess(id) && request.auth.uid == pApp(id).employerUid;}
  function pConsentRevision(id) {return exists(/databases/$(database)/documents/aligna_research_prototype_consents/$(id)) ? get(/databases/$(database)/documents/aligna_research_prototype_consents/$(id)).data.version : 0;}
  match /aligna_research_prototypes/{id} {
   allow get: if pAccess(id);
   allow create: if pOwner(id) && validRun(request.resource.data) && request.resource.data.revision == 1 && request.resource.data.events == [] && request.resource.data.lastReportId == '' && request.resource.data.createdAt == request.time;
   function validRun(d) {let a=pApp(id);return d.keys().hasOnly(['applicationId','ownerUid','seekerUid','jobRequirementsVersion','basisVersion','version','synthetic','linkedPerson','sourceJson','stateJson','revision','lastReportId','events','createdAt','updatedAt'])
    && d.applicationId == id && d.ownerUid == a.employerUid && d.seekerUid == a.seekerUid && d.jobRequirementsVersion == a.jobRequirementsVersion
    && d.basisVersion is string && d.basisVersion.size() <= 100 && d.version == 'synthetic-research-v1' && d.synthetic == true && d.linkedPerson == 'SIM-002'
    && d.sourceJson is string && d.sourceJson.size() > 1000 && d.sourceJson.size() <= 150000 && d.stateJson is string && d.stateJson.size() <= 20000
    && d.revision is int && d.revision >= 1 && d.lastReportId is string && d.lastReportId.size() <= 300 && d.events is list && d.events.size() <= 100 && d.updatedAt == request.time;}
   allow update: if pOwner(id) && validRun(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt && (
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReportId','updatedAt']) && request.resource.data.revision == resource.data.revision
     && getAfter(/databases/$(database)/documents/aligna_research_prototype_reports/$(request.resource.data.lastReportId)).data.runRevision == resource.data.revision
     && getAfter(/databases/$(database)/documents/aligna_research_prototype_reports/$(request.resource.data.lastReportId)).data.applicationId == id)
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stateJson','revision','events','lastReportId','updatedAt']) && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.lastReportId == ''
     && request.resource.data.events.size() == resource.data.events.size() + 1 && validEvent(request.resource.data.events[resource.data.events.size()])
     && request.resource.data.events == resource.data.events.concat([request.resource.data.events[resource.data.events.size()]])));
   function validEvent(e) {return e.keys().hasOnly(['sequence','actor','action','subject','synthetic']) && e.sequence == resource.data.events.size() + 1 && e.actor == 'hr' && e.synthetic == true && e.action in ['person','expert','rating','item','clear-items'] && e.subject is string && e.subject.size() <= 100;}
  }
  match /aligna_research_prototype_consents/{id} {
   function seeker() {return verifiedAccount() && pApp(id).seekerUid == request.auth.uid;}
   allow get: if seeker() || pOwner(id);
   function validConsent(d) {let a=pApp(id);return d.keys().hasOnly(['applicationId','ownerUid','seekerUid','version','synthetic','research','training','ratings','withdrawn','theta','asked','consentVersion','createdAt','updatedAt'])
    && d.applicationId == id && d.ownerUid == a.employerUid && d.seekerUid == a.seekerUid && d.synthetic == true && d.version is int && d.version >= 1
    && d.research is bool && d.training is bool && d.ratings is bool && d.withdrawn is bool && d.theta in [-2,-1,0,1,2]
    && d.asked is list && d.asked.size() <= 8 && d.asked.toSet().size() == d.asked.size() && d.asked.hasOnly([0,1,2,3,4,5,6,7])
    && d.consentVersion == 'prototype-linked-consent-v1' && d.updatedAt == request.time;}
   allow create: if seeker() && pAccess(id) && validConsent(request.resource.data) && request.resource.data.version == 1 && request.resource.data.createdAt == request.time;
   allow update: if seeker() && validConsent(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt && (
    (pAccess(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['research','training','ratings','withdrawn','version','updatedAt']) && request.resource.data.version == resource.data.version + 1)
    || (pAccess(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['theta','asked','updatedAt']) && request.resource.data.version == resource.data.version)
    || (!pApp(id).active && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['withdrawn','version','updatedAt']) && request.resource.data.withdrawn == true && request.resource.data.version == resource.data.version + 1));
  }
  match /aligna_research_prototype_reports/{id} {
   function appId() {return id.split('--')[0];}
   function current(d) {return d.runRevision == get(/databases/$(database)/documents/aligna_research_prototypes/$(d.applicationId)).data.revision && d.consentRevision == pConsentRevision(d.applicationId);}
   allow get: if pAccess(appId()) && (!exists(/databases/$(database)/documents/aligna_research_prototype_reports/$(id)) || current(resource.data));
   allow create: if pOwner(appId()) && request.resource.data.keys().hasOnly(['applicationId','ownerUid','seekerUid','version','synthetic','runRevision','consentRevision','sourceDigest','payload','productionEnabled','createdAt'])
    && request.resource.data.applicationId == appId() && request.resource.data.ownerUid == pApp(appId()).employerUid && request.resource.data.seekerUid == pApp(appId()).seekerUid
    && request.resource.data.version == 'synthetic-research-v1' && request.resource.data.synthetic == true && request.resource.data.productionEnabled == false && current(request.resource.data)
    && request.resource.data.payload is string && request.resource.data.payload.size() <= 150000 && request.resource.data.sourceDigest is string && request.resource.data.sourceDigest.size() <= 100
    && getAfter(/databases/$(database)/documents/aligna_research_prototypes/$(appId())).data.lastReportId == id && request.resource.data.createdAt == request.time;
  }
  match /aligna_news_items/{id} { allow read, create, update: if newsWorker(); }
  match /aligna_news_alerts/{id} { allow read, create, update: if newsWorker(); }
  match /aligna_news_runs/{id} { allow read, create, update: if newsWorker(); }
  match /aligna_news_state/{id} { allow read, create, update: if newsWorker(); }
  match /aligna_news_audit/{id} { allow read, create: if newsWorker(); }
  match /aligna_news_public/{sector} {
   allow read: if request.auth != null;
   allow create, update: if newsWorker();
  }
  match /aligna_news_subscriptions/{uid} {
   function ownsNews() { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; }
   allow read: if ownsNews() || newsWorker();
   allow create, update: if ownsNews()
    && request.resource.data.keys().hasOnly(['goalId','country','months','hours','skills','active','consentVersion','updatedAt'])
    && request.resource.data.goalId is string && request.resource.data.goalId.matches('[0-9]{2}-[0-9]{4}.[0-9]{2}')
    && request.resource.data.country in ['MY','SG','UK','AU','US']
    && request.resource.data.months in [3,5,6,12] && request.resource.data.hours is int && request.resource.data.hours >= 1 && request.resource.data.hours <= 40
    && request.resource.data.skills is list && request.resource.data.skills.size() <= 35
    && request.resource.data.active is bool && request.resource.data.consentVersion == 'career-news-v1'
    && request.resource.data.updatedAt is string;
  }
  match /aligna_users/{uid}/trend_updates/{id} {
   allow read: if request.auth != null && request.auth.uid == uid;
   allow create, update: if newsWorker() && id == 'current'
    && get(/databases/$(database)/documents/aligna_news_subscriptions/$(uid)).data.active == true
    && request.resource.data.keys().hasOnly(['version','goalId','goalTitle','sector','newsVersion','generatedAt','country','months','hours','coverage','baseline','priorities','referenceSources','phases','unchanged','method','evidenceScope','subscriptionUpdatedAt','updatedAt'])
    && request.resource.data.version == 'career-news-v1'
    && request.resource.data.priorities is list && request.resource.data.priorities.size() <= 6;
  }

 }
}
